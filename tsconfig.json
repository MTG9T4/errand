{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@errand/core": ["./packages/core/src/index.ts"],
      "@errand/mcp": ["./packages/mcp/src/index.ts"],
      "@errand/chroma": ["./packages/chroma/src/index.ts"],
      "@errand/mongodb": ["./packages/mongodb/src/index.ts"],
      "@errand/telegram": ["./packages/telegram/src/index.ts"],
      "@errand/twitter": ["./packages/twitter/src/index.ts"],
      "@errand/discord": ["./packages/discord/src/index.ts"],
      "@errand/hyperliquid": ["./packages/hyperliquid/src/index.ts"],
      "@errand/finance": ["./packages/finance/src/index.ts"],
      "@errand/create-errand": ["./packages/create-errand/src/index.ts"]
    }
  }
}
